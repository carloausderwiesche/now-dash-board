{
  "name": "nowboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "node --test --disable-warning=ExperimentalWarning 'src/**/*.test.ts'",
    "tauri": "tauri",
    "app": "tauri dev",
    "install-app": "tauri build --bundles app && rm -rf /Applications/Nowboard.app && cp -R src-tauri/target/release/bundle/macos/Nowboard.app /Applications/"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.0"
  }
}
